# ==============================================================================
# Terrarium Configurator - Environment Configuration
# Copy to .env and fill in. NEVER commit .env to Git.
# ==============================================================================

APP_NAME="Terrarium Configurator"
# production | local
APP_ENV=production
# generate with: php bin/console key:generate
APP_KEY=
APP_DEBUG=false
# Public URL of the site, WITHOUT trailing slash. Must be https:// in production (payment callbacks use it).
APP_URL=https://your-domain.ir
APP_TIMEZONE=Asia/Tehran
APP_CURRENCY=IRR
# debug | info | warning | error
LOG_LEVEL=warning

# Admin access: comma separated mobiles that become admins after OTP login
ADMIN_MOBILES=09120000000
AUTH_TOKEN_TTL_DAYS=30
# Flat shipping cost in Rials (0 = free)
SHIPPING_FLAT_RATE=0
# Only needed if the API is called from another domain
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Database (MySQL 8.0 on Windows Server)
# For local development you can use: DB_CONNECTION=sqlite (file in storage/database)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=terrarium_db
DB_USERNAME=terrarium_user
DB_PASSWORD=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# SMS & OTP
# ------------------------------------------------------------------------------
# kavenegar | log   ("log" = development only, the code is written to storage/logs)
SMS_DEFAULT_PROVIDER=kavenegar
SMS_API_KEY=
# Kavenegar Verify-Lookup template name (recommended). If empty, a normal SMS is sent from SMS_SENDER_NUMBER.
SMS_OTP_TEMPLATE=
SMS_SENDER_NUMBER=
OTP_EXPIRY_MINUTES=2
OTP_LENGTH=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_HOUR_PER_IP=20

# ------------------------------------------------------------------------------
# Payment gateways
# ------------------------------------------------------------------------------
# Gateways offered at checkout (comma separated): zarinpal, zibal, idpay, stripe
# ("test" = local simulator, automatically disabled when APP_ENV=production)
ENABLED_PAYMENT_GATEWAYS=zarinpal
DEFAULT_PAYMENT_GATEWAY=zarinpal

# ZarinPal (callback: ${APP_URL}/api/v1/payments/verify/zarinpal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Zibal (sandbox uses the public test merchant "zibal")
ZIBAL_MERCHANT_ID=
ZIBAL_SANDBOX=false

# IDPay
IDPAY_API_KEY=
IDPAY_SANDBOX=false

# Stripe — only works when APP_CURRENCY matches STRIPE_CURRENCY (Stripe does not support IRR)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD

# ---------------------------------------------------------------------------
# Bale messenger (https://docs.bale.ai)
# BALE_BOT_TOKEN       : from @botfather in Bale
# BALE_BOT_USERNAME    : bot username without @ (used in https://ble.ir/<username> links)
# BALE_WALLET_TOKEN    : wallet provider token for invoices (test: WALLET-TEST-1111111111111111)
#                        and add "bale" to ENABLED_PAYMENT_GATEWAYS
# BALE_SAFIR_API_KEY   : Safir API key — messages users who never started the bot (OTP + pay link)
# BALE_OTP_ENABLED     : login codes ONLY via the Bale bot (no SMS; non-Bale numbers get an error)
# After setting these: Admin panel → System → "Connect bot" (needs https), or
#   php bin/console bale:webhook     (https)   |   php bin/console bale:poll   (no https)
# ---------------------------------------------------------------------------
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_WALLET_TOKEN=
BALE_SAFIR_API_KEY=
BALE_OTP_ENABLED=false
BALE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Outgoing HTTPS (Bale, gateways). The project ships resources/cacert.pem, so php.ini needs no curl.cainfo.
# If an antivirus/firewall intercepts HTTPS ("self-signed certificate in certificate chain"):
#   disable its HTTPS scanning for php-cgi.exe, OR export its root certificate (.pem) and set HTTP_CA_FILE.
# HTTP_SSL_VERIFY=false turns verification off (insecure, last resort only).
# ---------------------------------------------------------------------------
HTTP_CA_FILE=
HTTP_SSL_VERIFY=true
