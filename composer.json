{
    "name": "terrarium/configurator",
    "type": "project",
    "description": "Terrarium Configurator - Modular Monolith with DDD & Clean Architecture on Windows Server + IIS",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "pestphp/pest": "^2.34"
    },
    "autoload": {
        "psr-4": {
            "Terrarium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
