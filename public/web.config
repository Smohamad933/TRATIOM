<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!-- PHP via FastCGI. Change scriptProcessor if PHP is installed elsewhere
             (install.ps1 updates it automatically from -PhpPath). -->
        <handlers>
            <remove name="WebDAV" />
            <remove name="PHP_via_FastCGI" />
            <remove name="PHP_via_FastCGI_Terrarium" />
            <add name="PHP_via_FastCGI"
                 path="*.php"
                 verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\php\php-cgi.exe"
                 resourceType="Unspecified" />
        </handlers>

        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <rewrite>
            <rules>
                <!-- Force HTTPS: enable after installing an SSL certificate (payment gateways require https callbacks) -->
                <rule name="Force HTTPS" enabled="false" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Anything that is not a real file/folder goes to the front controller -->
                <rule name="Front Controller" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <remove segment=".env" />
                    <add segment=".env" />
                    <remove segment=".git" />
                    <add segment=".git" />
                </hiddenSegments>
                <fileExtensions>
                    <remove fileExtension=".ini" />
                    <add fileExtension=".ini" allowed="false" />
                    <remove fileExtension=".log" />
                    <add fileExtension=".log" allowed="false" />
                    <remove fileExtension=".sql" />
                    <add fileExtension=".sql" allowed="false" />
                    <remove fileExtension=".sqlite" />
                    <add fileExtension=".sqlite" allowed="false" />
                </fileExtensions>
                <requestLimits maxAllowedContentLength="8388608" />
            </requestFiltering>
        </security>

        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

        <!-- PassThrough: let the app return its own JSON errors (404/422/...) instead of IIS pages -->
        <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

        <httpProtocol>
            <customHeaders>
                <remove name="X-Frame-Options" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="Referrer-Policy" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <remove name="Permissions-Policy" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
