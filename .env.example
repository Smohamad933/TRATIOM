# ==============================================================================
# Terrarium Configurator - Environment Configuration
# Windows Server + IIS + FastCGI + MySQL 8.0
# ==============================================================================

APP_NAME="Terrarium Configurator"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Database Settings (MySQL 8.0 on Windows Server)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=terrarium_db
DB_USERNAME=terrarium_user
DB_PASSWORD=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Session, Cache & Queue (Windows Safe Drivers)
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# SMS & OTP Authentication Settings
# ------------------------------------------------------------------------------
# Providers: kavenegar, melipayamak, log
SMS_DEFAULT_PROVIDER=kavenegar
SMS_API_KEY=YOUR_SMS_API_KEY_HERE
SMS_SENDER_NUMBER=10008000
OTP_EXPIRY_MINUTES=2
OTP_LENGTH=5
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# Payment Gateways (Live & Sandbox Keys)
# ------------------------------------------------------------------------------
DEFAULT_PAYMENT_GATEWAY=zarinpal

# ZarinPal
ZARINPAL_MERCHANT_ID=YOUR_ZARINPAL_MERCHANT_ID_HERE
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL="${APP_URL}/api/v1/payments/verify/zarinpal"

# Zibal
ZIBAL_MERCHANT_ID=YOUR_ZIBAL_MERCHANT_ID_HERE
ZIBAL_SANDBOX=false
ZIBAL_CALLBACK_URL="${APP_URL}/api/v1/payments/verify/zibal"

# IDPay
IDPAY_API_KEY=YOUR_IDPAY_API_KEY_HERE
IDPAY_SANDBOX=false
IDPAY_CALLBACK_URL="${APP_URL}/api/v1/payments/verify/idpay"

# Stripe (International Payments)
STRIPE_PUBLIC_KEY=pk_live_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=USD

# ------------------------------------------------------------------------------
# Windows Server & IIS Specific Paths
# ------------------------------------------------------------------------------
WINDOWS_PHP_BINARY_PATH="C:\\PHP83\\php.exe"
WINDOWS_NSSM_WORKER_SERVICE="TerrariumQueueWorker"
