<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root web.config — lets the site work when the IIS site points at the PROJECT folder
  (e.g. G:\web-site\test) instead of the public folder.
  Every request is served from public\ ; source code, .env and storage are never reachable.
  If your IIS site points directly at public\ this file is simply not used.
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <handlers>
            <remove name="WebDAV" />
            <remove name="PHP_via_FastCGI" />
            <remove name="PHP_via_FastCGI_Terrarium" />
            <add name="PHP_via_FastCGI"
                 path="*.php"
                 verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\php\php-cgi.exe"
                 resourceType="Unspecified" />
        </handlers>

        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <rewrite>
            <rules>
                <!-- Enable after SSL is installed on this server (leave disabled if SSL is done by a CDN) -->
                <rule name="Root Force HTTPS" enabled="false" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Already inside public/ : nothing to do -->
                <rule name="Root Public Passthrough" stopProcessing="true">
                    <match url="^public/" />
                    <action type="None" />
                </rule>

                <!-- Real files in public\ (assets, install.php, admin, ...) -->
                <rule name="Root Public Files" stopProcessing="true">
                    <match url="^(.+)$" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{APPL_PHYSICAL_PATH}public\{R:1}" matchType="IsFile" />
                        <add input="{APPL_PHYSICAL_PATH}public\{R:1}" matchType="IsDirectory" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>

                <!-- Everything else (/, /api/..., /health, /.env, /src/...) goes to the front controller -->
                <rule name="Root Front Controller" stopProcessing="true">
                    <match url=".*" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>

        <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    </system.webServer>
</configuration>
